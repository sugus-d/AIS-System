# =============================================================================
# AIS 项目环境变量 —— 参考模板
# =============================================================================
# 使用方式：
#   cp .env.example .env   # 然后编辑 .env 文件
#
# .env 中的值会覆盖 ~/.claude/settings.json 中 `env` 字段的默认值。
# 修改 .env 后立即生效，无需重启。
# =============================================================================

# ── AIS_HOOK_PROFILE：钩子严苛度 ─────────────────────────────────
# 控制哪些后台钩子（质量门、成本追踪、session 评估等）在会话中运行。
# 可选值：
#   dev     = 开发模式
#             - 运行的钩子：配置保护、读门、secret 检测、状态持久化、失败追踪
#             - 跳过的钩子：质量门、成本追踪、session 评估、持续学习
#             - 不拦截 print，不阻断 lint
#             适合日常算法开发和调试
#   std     = 标准模式（默认）
#             - 所有钩子运行
#             - lint 检查给出警告但不阻断
#             适合常规开发流程
#   strict  = 严格模式
#             - 所有钩子运行
#             - lint 错误和 print 残留会阻断（stop-batch 返回非零退出码）
#             适合提交前的最终检查
#
# 切换建议：日常开发用 dev，提交前切 std 或 strict
AIS_HOOK_PROFILE=std

# ── AIS_MODE：AI 行为模式 ───────────────────────────────────────
# 改变 AI 在处理任务时的行为倾向。
# 可选值：
#   dev      = 算法开发模式
#             - 行为：先写代码再验证，容忍 print 调试，快速迭代
#             - 适用场景：新 landmark 算法、pipeline 参数调整、写测试
#   research = 数据分析模式
#             - 行为：先读数据/可视化/报告，每个结论附数据支持
#             - 适用场景：分析定位精度、对比算法效果、生成验证报告
#   review   = 代码审查模式
#             - 行为：先读完整文件再修改，严格质量门，零 print 残留
#             - 适用场景：PR 提交前检查、跨 session 代码复查
AIS_MODE=dev

# ── AIS_DESKTOP_NOTIFY：桌面通知 ──────────────────────────────────
# 长时间任务完成后是否弹桌面通知。
# 触发条件：session 持续 >2分钟 且有文件变更
# 可选值：
#   off  = 关闭（默认），不弹通知
#   on   = 开启，Windows 下弹 MessageBox，Linux 下用 notify-send
#
# 适用场景：跑验证集、批量处理等耗时操作时开启
AIS_DESKTOP_NOTIFY=off